    "legacy_code_may_be_reused_as_infrastructure": true
  },
  "question_h1": "Do the same flower-colour transition edges recur when georeferenced flower photographs are repeatedly resampled without fixing a focal species set?",
  "unit": "photograph",
  "species_role": "retained for sampling caps, dominance audit, and within-species null only; not fixed as the display or response unit",
  "primary_grid": {
    "type": "equal-area longitude by sin(latitude)",
    "n_lon": 18,
    "n_sinlat": 9,
    "longitude_wrap": true
  },
  "primary_sampling": {
    "photos_per_replicate": 10000,
    "replicates": 200,
    "selection": "cell-first round-robin after within-cell species cap",
    "species_cap_per_cell_per_replicate": 2,
    "minimum_photos_per_cell": 5,
    "sampling_must_not_use_morph_or_continuous_colour": true
  },
  "coarse_morph_v1": {
    "source_fields": [
      "blue",
      "bronze",
      "magenta",
      "orange",
      "pink",
      "purple",
      "red",
      "white",
      "yellow"
    ],
    "groups": {
      "white": ["white"],
      "yellow_orange": ["yellow", "orange", "bronze"],
      "red_pink": ["red", "pink", "magenta"],
      "blue_purple": ["blue", "purple"]
    },
    "minimum_dominant_fraction": 0.5,
    "minimum_margin_over_second_group": 0.1,
    "otherwise": "mixed_uncertain",
    "species_standardized_colour_vectors_are_prohibited_for_pooled_absolute_colour": true
  },
  "transition": {
    "cell_summary": "morph composition vector",
    "edge_metric": "Jensen-Shannon divergence in bits",
    "edge_metric_range": [0.0, 1.0],
    "transition_definition": "top 10 percent of evaluable edge intensities within each replicate",
    "transition_quantile": 0.9
  },
  "persistence": {
    "edge_numerator": "number of replicates where edge is a transition",
    "edge_denominator": "number of replicates where both adjacent cells satisfy the minimum photo count",
    "unevaluable_replicates_are_structural_missingness_not_zero": true,
    "global_statistic": "opportunity-weighted variance of edge persistence around the realized global transition rate"
  },
  "primary_null": {
    "scope": "shuffle morph labels strictly within species while preserving locations and species frequencies",
    "sampling_seeds_reused_across_observed_and_null": true,
    "permutations": 999,
    "tail": "upper",
    "alpha": 0.05
  },
  "predeclared_sensitivities": {
    "grids": [
      {"n_lon": 12, "n_sinlat": 6},
      {"n_lon": 24, "n_sinlat": 12}
    ],
    "species_cap_per_cell_per_replicate": [1, 2],
    "report_global_continent_within_and_biome_within": true,
