{
  "protocol": "random-photo-first-boundary-persistence-v1",
  "status": "analysis_core_frozen_before_fresh_global_candidate_pool_is_opened",
  "created_for": "new prospective exploratory-validation atlas",
  "legacy_firewall": {
    "frozen_34_species_comparison_is_input": false,
    "six_species_held_out_result_is_input": false,
    "pr21_terminal_60000_photo_records_are_input": false,
