{
  "protocol": "global-rgfca-chelsa-expanded-source-acquisition-v1",
  "status": "exact_postoutcome_secondary_chelsa_source_urls_frozen_before_any_expanded_chelsa_colour_alignment",
  "date": "2026-09-06",
